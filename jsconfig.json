{
   "compilerOptions": {
      "baseUrl": "src",
      "target": "ES2020",
      "allowJs": true,
      "checkJs": false,
      "moduleResolution": "node",
      "jsx": "react",
      "strict": false,
      "noEmit": true,
      "allowSyntheticDefaultImports": true,
      "skipLibCheck": true,
      "paths": {
         "@/*": ["./*"]
      }
   },
   "include": ["src/**/*"],
   "exclude": ["node_modules", "dist", "build"]
}
