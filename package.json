{
   "name": "toe",
   "version": "0.1.0",
   "type": "module",
   "description": "an infinite tic tac toe",
   "main": "server/app.js",
   "scripts": {
      "start": "node server/app.js",
      "backend": "nodemon server/app.js",
      "frontend": "vite",
      "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
      "build": "vite build",
      "preview": "vite preview",
      "test": "echo \"Error: no test specified\" && exit 1",
      "format": "prettier --write .",
      "format:check": "prettier --check .",
      "prepare": "husky install"
   },
   "license": "ISC",
   "lint-staged": {
      "*.{js,jsx,ts,tsx,json,css,md}": [
         "prettier --write"
      ]
   },
   "dependencies": {
      "@prisma/client": "^6.14.0",
      "bcrypt": "^6.0.0",
      "better-auth": "^1.3.7",
      "express": "^4.21.1",
      "react": "^19.1.1",
      "react-dom": "^19.1.1",
      "socket.io": "^4.8.1",
      "typescript": "^5.9.2",
      "zod": "^4.0.17"
   },
   "devDependencies": {
      "@vitejs/plugin-react": "^4.7.0",
      "concurrently": "^9.2.0",
      "globals": "^16.3.0",
      "husky": "^8.0.0",
      "lint-staged": "^16.1.5",
      "prettier": "3.6.2",
      "prisma": "^6.14.0",
      "ts-migrate": "^0.1.35",
      "vite": "^7.0.6"
   }
}
