{
   "name": "toe",
   "version": "0.1.0",
   "type": "module",
   "description": "an infinite tic tac toe",
   "main": "server/app.ts",
   "scripts": {
      "start": "concurrently \"node dist/server/app.js\" \"vite preview\"",
      "backend:build": "tsc -p tsconfig.server.json",
      "frontend": "vite",
      "dev": "concurrently \"tsc -w -p tsconfig.server.json\" \"vite\"",
      "build": "vite build && tsc -p tsconfig.server.json",
      "preview": "concurrently \"node dist/server/app.js\" \"vite preview\"",
      "type-check": "tsc -p tsconfig.json --noEmit",
      "test": "jest",
      "format": "prettier --write .",
      "format:check": "prettier --check .",
      "lint:css": "stylelint \"src/**/*.css\"",
      "prepare": "husky install"
   },
   "license": "ISC",
   "lint-staged": {
      "*.{js,jsx,ts,tsx,json,css,md}": [
         "prettier --write"
      ]
   },
   "dependencies": {
      "@prisma/client": "^6.14.0",
      "bcrypt": "^6.0.0",
      "better-auth": "^1.3.7",
      "express": "^4.21.1",
      "lucide-react": "^0.540.0",
      "react": "^19.1.1",
      "react-dom": "^19.1.1",
      "socket.io": "^4.8.1",
      "typescript": "^5.9.2",
      "zod": "^4.0.17"
   },
   "devDependencies": {
      "@testing-library/react": "^16.3.0",
      "@types/express": "^5.0.3",
      "@types/jest": "^30.0.0",
      "@types/node": "^24.3.0",
      "@types/react": "^19.1.10",
      "@types/react-dom": "^19.1.7",
      "@vitejs/plugin-react": "^4.7.0",
      "concurrently": "^9.2.0",
      "globals": "^16.3.0",
      "husky": "^8.0.0",
      "jest": "^30.0.5",
      "lint-staged": "^16.1.5",
      "prettier": "3.6.2",
      "prisma": "^6.14.0",
      "stylelint": "^16.23.1",
      "stylelint-config-css-modules": "^4.5.1",
      "stylelint-config-standard": "^39.0.0",
      "vite": "^7.0.6"
   }
}
